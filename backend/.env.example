# Server Configuration
PORT=5000
# In development keep NODE_ENV=development. On hosting set NODE_ENV=production
# (or serverless platforms like Vercel set production automatically).
NODE_ENV=development

# Frontend origin(s) allowed by CORS. Include full https:// URL in production.
# Comma-separated values are supported. Bare domains are normalized automatically.
CLIENT_URL=http://localhost:5173
# CLIENT_URLS=https://your-frontend.vercel.app,https://your-custom-domain.com

DATABASE_URL=
VERCEL=1 automatically; the pool stays
# small there so many serverless instances don't exhaust the DB's socket limit
# (TiDB Serverless free tier caps connections). Override with DB_POOL_MAX if
# needed. Leave unset for a traditional always-on host (pool defaults to 5).
# DB_POOL_MAX=1
# SERVERLESS=1  # force the serverless pool sizing if not running on Vercel

# JWT Configuration
JWT_SECRET=
JWT_EXPIRE=

# Email Configuration (for password recovery)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=

# File Upload Configuration
MAX_FILE_SIZE=
UPLOAD_PATH=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX_REQUESTS=

# AI Provider Configuration (optional — agents fall back to offline/sample responses when unset)
# Provider defaults to Groq (OpenAI-compatible endpoint). Set AI_PROVIDER=openai to hit OpenAI directly.
# AI_PROVIDER=groq
# AI_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
# AI_MODEL=llama-3.3-70b-versatile
# Vision-capable Groq model for Ifeanyi photo answers: AI_MODEL=llama-3.2-11b-vision-preview
# Deprecated/back-compat: OPENAI_API_KEY is used only when GROQ_API_KEY is unset.
OPENAI_API_KEY=
OPENAI_MODEL=
