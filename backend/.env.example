# Server Configuration
PORT=5000
# In development keep NODE_ENV=development. On hosting set NODE_ENV=production
# (or serverless platforms like Vercel set production automatically).
NODE_ENV=development

# Database Configuration
# Switch DB entirely via DB_DIALECT: 'sqlite' (no server needed) or 'mysql'
DB_DIALECT=sqlite
# --- SQLite settings (used when DB_DIALECT=sqlite) ---
DB_STORAGE=./data
DB_FILE=education-platform.sqlite
# --- MySQL settings (used when DB_DIALECT=mysql) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=education_platform
DB_USER=root
DB_PASSWORD=your_mysql_password
# Connection pool tuning. Vercel sets VERCEL=1 automatically; the pool stays
# small there so many serverless instances don't exhaust the DB's socket limit
# (TiDB Serverless free tier caps connections). Override with DB_POOL_MAX if
# needed. Leave unset for a traditional always-on host (pool defaults to 5).
# DB_POOL_MAX=1
# SERVERLESS=1  # force the serverless pool sizing if not running on Vercel

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRE=7d

# Email Configuration (for password recovery)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_email_password

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# OpenAI Configuration (optional — assessment agent falls back to sample questions when unset)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
