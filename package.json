{
  "name": "eduflow",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm --workspace backend run dev",
    "dev:frontend": "npm --workspace frontend run dev",
    "build": "npm --workspace frontend run build",
    "seed": "npm --workspace backend run db:seed",
    "test": "jest --runInBand --detectOpenHandles"
  },
  "description": "EduFlow is an education platform monorepo with a **React 19 + Vite** single-page app (SPA) and a **Node.js + Express + Sequelize** REST API. It supports role-based access (admin, instructor, student), course delivery, assessments, messaging, gamification, and AI-assisted assessment generation.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vhicthorace2/eduflow.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/vhicthorace2/eduflow/issues"
  },
  "homepage": "https://github.com/vhicthorace2/eduflow#readme"
}